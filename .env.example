DATABASE_URL=postgresql://user:password@host/database?sslmode=require
MASTER_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-32-or-more-random-bytes
ENCRYPTION_KEY=replace-with-a-separate-32-byte-hex-key
BLOB_STORE_ID=replace-with-private-blob-store-id
VERCEL_OIDC_TOKEN=replace-with-local-development-oidc-token
